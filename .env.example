# Optional: Free no-credit-card high-accuracy weather API keys
# 1. Tomorrow.io (Recommended: AI + Radar, 500 calls/day free, no credit card):
EXPO_PUBLIC_TOMORROW_API_KEY=
# 2. WeatherAPI.com (100,000 calls/month free, no credit card):
EXPO_PUBLIC_WEATHERAPI_KEY=
# 3. Optional Google Maps Platform Weather API Key (WeatherNext, requires Cloud Billing):
EXPO_PUBLIC_GOOGLE_WEATHER_API_KEY=
# When all keys are blank, WeatherBuddy automatically uses Open-Meteo Free + US AQI.
